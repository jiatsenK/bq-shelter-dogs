// 網站＋API 合在一起的 Cloudflare Worker（#125）
// - 網頁是靜態檔案（assets，只放 public/），API 在 /api 底下（worker/src/index.js）；照片放 R2（#130），repo 裡的舊照片當備援
// - main 有推送就由 GitHub Action 自動部署（.github/workflows/deploy-cloudflare.yml），不用手動貼程式
// - Secret（ADMIN_KEY、WALKER_KEY、SHEET_WRITE_KEY 等）不寫在這裡：設在 GitHub Secrets，部署時一起帶上去，步驟見 docs/setup/CLOUDFLARE_SETUP.md
// - 只有 public/ 會放上網站，其他資料夾都不公開（#276 起不再需要 .assetsignore）
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bq-shelter-dogs",
  "main": "worker/src/index.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // 照片放 R2（#130）：照片、dogs.json（照片版本號）也先經過 Worker，Worker 讀 R2、讀不到再給 repo 裡的舊檔（相簿 K 2026-10-09 拿掉）
    "run_worker_first": ["/api/*", "/api", "/photos/*"]
  },
  // 照片空間（#130）：Cloudflare R2 的 bucket，Worker 裡叫 env.PHOTOS。bucket 要先在 Cloudflare 開通 R2 後建立
  // 部署只驗證既有空間；失敗就停止，不能拿掉綁定（#214）
  "r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "bq-shelter-photos" }],
  // 固定正式庫；部署不建表或匯入。預覽版由準備腳本切換為隔離測試庫。
  "d1_databases": [{
    "binding": "DB",
    "database_name": "bq-shelter-dogs",
    "database_id": "6cd6c304-0fed-4ddb-b9ec-799e60a4adb4",
    "preview_database_id": "9e23a65c-c9dd-4f83-ad9c-2e01626910f0"
  }],
  "vars": {
    // #460：溜狗每天的寫入保留量上限（ADR 0008）；同時是帳號當日寫入量的檢查門檻。
    "SYNC_DAILY_BUDGET": "40000",
    // #685：上面的量裡，寫回重試每天最多保留這麼多；用完的重試等隔天，志工新的登記照常有預算。
    "SYNC_RETRY_DAILY_BUDGET": "5000",
    // #498（ADR 0018）：人工改表的今日溜狗寫進 D1；沒設時 GAS 會一直補送失敗。2026-10-24 由密鑰改到這裡，讓 repo 看得到。
    "D1_WALK_NOTIFY": "1",
    // #498：保險掃描（每天三次）與網站登記寫回試算表的重試；預覽版另有 PREVIEW 擋下。
    "WALK_RETRY_ENABLED": "true"
  },
  // 排程數量算整個 Cloudflare 帳號，免費方案上限 5 個（稽核第 5 項）：正式版 2 個＋測試網站 1 個，留 2 個給其他專案。
  // 狗清單（#501，ADR 0018）：有人編輯才由 GAS 送列，不再每 10 分鐘叫 GitHub 同步。
  // 溜狗（#500，ADR 0018）：錯開 5 分鐘只跑寫回重試（沒工作就結束、不讀表）；台灣 09:23、13:23、23:23 保險掃描只比指紋（跟 GAS 的 dogListScan 錯開，研究 2026-10-26），
  // 每月 1 日 09:23 那次順便清照片垃圾桶。改這裡要一起改 worker/src/index.js 的 RETRY_CRON、SCAN_CRON
  "triggers": {
    "crons": ["5-59/10 * * * *", "23 1,5,15 * * *"]
  },
  // 稽核第 3 項（2026-10-26）：PR 預覽改上傳到獨立 Worker bq-shelter-dogs-preview（.github/workflows/preview-cloudflare.yml）。
  // 正式 Worker 的版本會帶著正式密鑰，所以關掉正式 Worker 的預覽網址，舊的 pr-<編號>-bq-shelter-dogs 網址一起失效
  "preview_urls": false,
  // 不保留 Cloudflare 網頁上另外加的變數：正式部署只用這裡的 vars，確保預覽版的 PREVIEW 不會被帶進正式版。
  // Secret（ADMIN_KEY 等）不受影響，部署時一律保留
  "keep_vars": false
}
