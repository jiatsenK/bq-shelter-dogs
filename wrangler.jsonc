// 網站＋API 合在一起的 Cloudflare Worker（#125）
// - 網頁、data/ 是靜態檔案（assets），API 在 /api 底下（worker/src/index.js）；照片放 R2（#130），repo 裡的舊照片當備援
// - main 有推送就由 GitHub Action 自動部署（.github/workflows/deploy-cloudflare.yml），不用手動貼程式
// - Secret（GITHUB_TOKEN、NOTES_PASSCODE、WALKER_KEY）不寫在這裡：設在 GitHub Secrets，部署時一起帶上去，步驟見 docs/CLOUDFLARE_SETUP.md
// - 不公開的檔案列在 .assetsignore
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bq-shelter-dogs",
  "main": "worker/src/index.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // 照片放 R2（#130）：照片、dogs.json（照片版本號）、相簿清單也先經過 Worker，Worker 讀 R2、讀不到再給 repo 裡的舊檔
    "run_worker_first": ["/api/*", "/api", "/photos/*", "/data/dogs.json", "/data/gallery.json"]
  },
  // 照片空間（#130）：Cloudflare R2 的 bucket，Worker 裡叫 env.PHOTOS。bucket 要先在 Cloudflare 開通 R2 後建立
  // （docs/CLOUDFLARE_SETUP.md「照片放 R2」）；還沒建好時部署會自動拿掉這段（scripts/r2-bucket.mjs），照片照舊存 GitHub
  "r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "bq-shelter-photos" }],
  "vars": {
    "GITHUB_REPO": "jiatsenK/bq-shelter-dogs",
    "GITHUB_BRANCH": "main"
  },
  // 定時叫 GitHub 跑同步試算表（UTC；台灣 7:00–22:30 每 30 分鐘）。
  "triggers": {
    "crons": ["0,30 23,0-14 * * *"]
  },
  // 每個 PR 的預覽網址（#126，.github/workflows/preview-cloudflare.yml）：https://pr-<編號>-bq-shelter-dogs.<帳號>.workers.dev
  "preview_urls": true,
  // 不保留 Cloudflare 網頁上另外加的變數：正式部署只用這裡的 vars，確保預覽版的 PREVIEW 不會被帶進正式版。
  // Secret（GITHUB_TOKEN 等）不受影響，部署時一律保留
  "keep_vars": false
}
