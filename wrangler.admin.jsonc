// Independent, read-only admin entry point. No cron or machine credentials.
// Set the three required vars and a protected custom domain in a reviewed deployment config.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bq-shelter-dogs-admin",
  "main": "worker/src/admin/index.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  "preview_urls": false,
  "build": { "command": "node scripts/build-admin-assets.mjs" },
  "assets": {
    "directory": "./admin/public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "bq-shelter-dogs",
    "database_id": "6cd6c304-0fed-4ddb-b9ec-799e60a4adb4"
  }],
  "r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "bq-shelter-photos" }],
  "vars": { "ADMIN_ORIGIN": "", "ACCESS_TEAM_DOMAIN": "", "ACCESS_AUD": "" },
  "keep_vars": false
}
