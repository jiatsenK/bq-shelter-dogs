// #460 CPU 驗收的回呼 Worker：扮演正式環境裡 Apps Script 打回來的 /api/walk-writeback/target、/receipt。
// 只接隔離測試 D1，不開公開網址，只由 bq-shelter-dogs-cpu 經服務綁定呼叫；跟它一起部署、一起刪除。
{
  "name": "bq-shelter-dogs-cpu-cb",
  "main": "worker/cpu-bench/index.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  "d1_databases": [{
    "binding": "DB",
    "database_name": "bq-shelter-dogs-test",
    "database_id": "9e23a65c-c9dd-4f83-ad9c-2e01626910f0"
  }],
  "vars": {
    "BENCH_ROLE": "callback",
    "WALK_RETRY_ENABLED": "true",
    "D1_WALK_NOTIFY": "1",
    "SHEET_WRITE_URL": "https://fake-gas.invalid/exec",
    "SYNC_DAILY_BUDGET": "1000000"
  }
}
