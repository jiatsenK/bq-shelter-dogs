      "css": ".ds-cage{display:inline-flex;align-items:center;gap:2px;padding:3px 8px 3px 5px;border:none;border-radius:2px;background:#fff;color:var(--ink,#16211D);box-shadow:inset 0 0 0 1.5px var(--ink,#16211D);font-family:inherit;font-size:14px;font-weight:700;letter-spacing:0.02em;cursor:pointer}.ds-cage:active{background:var(--tab-amber,#F2B21B)}.ds-cage:focus-visible{outline:3px solid var(--tab-amber,#F2B21B);outline-offset:2px}"
