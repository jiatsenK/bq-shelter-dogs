      "html": "<div class=\"ds-stack\"><div class=\"ds-card\"><div class=\"ds-thumb\"></div><div class=\"ds-name\">蔥餅</div><div class=\"ds-day amber\"><span>上次溜</span><b>20 天前</b></div></div><div class=\"ds-card\"><div class=\"ds-thumb\"></div><div class=\"ds-name\">阿拉丁</div><div class=\"ds-day sage\"><span>上次溜</span><b>5 天前</b></div></div><div class=\"ds-card\"><div class=\"ds-thumb\"></div><div class=\"ds-name\">小黑</div><div class=\"ds-day red\"><span>上次溜</span><b>30 天前</b></div></div></div>",
      "css": ".ds-stack{max-width:360px;background:var(--bg,#E3E9E5);padding:8px}.ds-card{display:flex;align-items:stretch;gap:10px;padding:8px;background:#fff;border:1px solid var(--line,#C4CFC9);border-radius:0;cursor:pointer}.ds-card+.ds-card{margin-top:-1px}.ds-card:active{background:var(--surface-soft,#EEF2EF)}.ds-thumb{width:64px;height:64px;border-radius:2px;background:var(--surface-soft,#EEF2EF)}.ds-name{flex:1;align-self:center;font-size:17px;font-weight:700;color:var(--ink,#16211D)}.ds-day{width:76px;margin:-8px -8px -8px 2px;display:flex;flex-direction:column;justify-content:center;text-align:center;background:var(--tab-muted,#6B756F);color:#fff;transition:background-color .4s ease-out,color .4s ease-out}.ds-day span{font-size:12px}.ds-day b{font-size:17px;font-weight:800;font-variant-numeric:tabular-nums}.ds-day.red{background:var(--tab-red,#C8202B)}.ds-day.amber{background:var(--tab-amber,#F2B21B);color:var(--ink,#16211D)}.ds-day.sage{background:var(--green-bg,#DFF0E4);color:var(--green-text,#1E6B3C);box-shadow:inset 1px 0 0 var(--line,#C4CFC9)}"
    },
