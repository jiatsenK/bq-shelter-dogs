.claude
.wrangler
node_modules
worker
scripts
wrangler.jsonc
wrangler.no-r2.json
wrangler.deploy.json
wrangler.preview.json
wrangler.preview-db.jsonc
.assetsignore
AGENT_LOG.md
AGENTS.md
CLAUDE.md
.impeccable
PRODUCT.md
DESIGN.md
db

# 搬遷私密匯出不得打包部署
.migration-private
