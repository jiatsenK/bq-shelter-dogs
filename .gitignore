# wrangler dev 的本機暫存（#125 起 wrangler.jsonc 在 repo 根目錄）
.wrangler/
node_modules/
.scratch/checks/
# 網頁測試自動拍的截圖：每次跑測試都會重拍覆蓋，不提交，避免誤 commit
.scratch/**/*.png
.dev.vars
# impeccable 比較頁的暫存
.impeccable/questions/
.impeccable/review/
# 部署時產生的設定和匯入檔（scripts/r2-bucket.mjs、scripts/d1-database.mjs）
wrangler.no-r2.json
wrangler.deploy.json
wrangler.preview.json
db/seed.sql
# 正式資料庫的匯出（搬遷用），不可以提交
.migration-private/
admin/public/shared/

# 介紹搬家核對表（#665）：含原文地址，不可以提交
